// ONYX CRM - podatkovna shema
//
// Opomba glede statusov: SQLite ne podpira nativnih "enum" tipov v Prisma,
// zato je `status` shranjen kot String z vrednostmi "NEW" | "NO_ANSWER" |
// "INTERESTED" | "REJECTED" (glej src/types/contact.ts). Ko boste bazo
// kasneje preselili na Postgres (npr. ob objavi na Vercel), lahko to polje
// po želji spremenite v pravi `enum` - koda že povsod uporablja ta ista
// string literal tipa, zato je migracija enostavna.
//
// Baza: Vercel "Prisma Postgres" integracija (dodana ob uvozu projekta)
// sama nastavi DATABASE_URL (prisma+postgres:// povezava prek Prisma
// Accelerate, vključuje pooling). Za razliko od Neona ne potrebuje
// ločenega DIRECT_URL za `prisma db push`/`migrate` - Prisma Postgres to
// podpira neposredno prek iste povezave.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Agent {
  id           String   @id @default(cuid())
  firstName    String
  lastName     String
  username     String   @unique
  passwordHash String
  isAdmin      Boolean  @default(false)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  callLogs CallLog[]
  meetings Meeting[]

  @@index([active])
}

model Contact {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  company   String?
  phone     String?
  email     String?
  notes     String?
  status    String   @default("NEW")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  callLogs CallLog[]
  meetings Meeting[]

  @@index([status])
}

// Sestanki, ki jih agenti vpisujejo za posamezne kontakte ("koledar").
// Vsak sestanek je vedno vezan na obstoječ kontakt in na agenta, ki ga je
// vpisal - prostih/nepovezanih vnosov ni. Agent na strani /koledar vidi
// samo svoje sestanke; admin lahko preklopi na pregled vseh agentov.
model Meeting {
  id        String   @id @default(cuid())
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId String
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId   String
  startAt   DateTime
  note      String?
  createdAt DateTime @default(now())

  @@index([agentId, startAt])
  @@index([contactId])
}

model CallLog {
  id        String   @id @default(cuid())
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId String
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId   String
  status    String
  note      String?
  createdAt DateTime @default(now())

  @@index([agentId, createdAt])
  @@index([contactId])
}
