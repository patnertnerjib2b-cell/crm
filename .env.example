# Neon (ali kateri koli drug Postgres ponudnik) - povezava za aplikacijo med
# delovanjem. Pri Neonu uporabite "pooled" (vsebuje "-pooler" v imenu gostitelja).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/DBNAME?sslmode=require"

# Ne-pooled (direktna) povezava - uporablja jo samo `prisma db push` / `migrate`
# za spremembe sheme baze. Pri Neonu v "Connect" oknu izklopite "Pooled connection".
DIRECT_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require"
