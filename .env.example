# Povezava do baze. V produkciji (Vercel) jo samodejno nastavi integracija
# "Prisma Postgres" (prisma+postgres:// povezava prek Prisma Accelerate).
# Za lokalni razvoj lahko namesto tega uporabite poljuben Postgres ponudnik
# (Neon, Supabase ...) - zadostuje standardna "postgresql://" povezava.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Neobvezno: skrivnost za podpisovanje sejnih piškotkov za prijavo agentov.
# Če ni nastavljena, se za podpisovanje uporabi DATABASE_URL kot nadomestek -
# za produkcijo je priporočeno nastaviti svojo, naključno vrednost.
SESSION_SECRET="nastavite-dolg-nakljucen-niz"
